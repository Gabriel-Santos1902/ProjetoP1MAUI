<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoP1MAUI.PeriodosInserir"
             Title=":: PERÍODO > INSERIR ::">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Nome" />
        <Entry x:Name="entNome" Placeholder="Nome do período" MaxLength="50" />

        <Label Text="Sigla" />
        <Entry x:Name="entSigla" Placeholder="Sigla" MaxLength="5" />

        <Button Text="Salvar" Clicked="btnSalvarOnClick" />
        <Button Text="Voltar" Clicked="btnVoltarOnClick" />
    </VerticalStackLayout>
</ContentPage>